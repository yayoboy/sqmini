{
  "name": "SQLiteMicro",
  "version": "1.0.0",
  "description": "SQLite for Microcontrollers (ESP32 and RP2040) with support for SPIFFS, LittleFS, and SD Card storage",
  "keywords": "sqlite, database, esp32, rp2040, embedded, microcontroller, spiffs, littlefs, sdcard",
  "repository": {
    "type": "git",
    "url": "https://github.com/yayoboy/sqmini.git"
  },
  "authors": [
    {
      "name": "SQLite Micro Contributors"
    }
  ],
  "license": "MIT",
  "homepage": "https://github.com/yayoboy/sqmini",
  "frameworks": "arduino, espidf",
  "platforms": ["espressif32", "raspberrypi"],
  "build": {
    "flags": [
      "-DSQLITE_OMIT_LOAD_EXTENSION",
      "-DSQLITE_THREADSAFE=1",
      "-DSQLITE_DEFAULT_PAGE_SIZE=512",
      "-DSQLITE_DEFAULT_CACHE_SIZE=-64",
      "-DSQLITE_TEMP_STORE=3"
    ],
    "includeDir": "include",
    "srcDir": "src",
    "srcFilter": [
      "+<*>",
      "+<vfs/*>",
      "+<platform/*>"
    ]
  },
  "export": {
    "include": [
      "include/*",
      "src/sqlite3.h",
      "src/sqlite3ext.h"
    ]
  }
}
